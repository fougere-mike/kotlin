sub linkedHashMapTests_rTestRunner_k_(m as Object)
    m.suite_Str_Function1TestRunnerV_k_("LinkedHashMap", {invoke: function(m as Object) as Void
        m.test_Str_Function0V_k_("insertion order", {invoke: function() as Void
            map = LinkedHashMap_create_k_()
            set_rMutableMap_AnyN_AnyN_k_(map, "three", 3)
            set_rMutableMap_AnyN_AnyN_k_(map, "one", 1)
            set_rMutableMap_AnyN_AnyN_k_(map, "two", 2)
            keys = toList_rIterable_k_(map.get_keys())
            assertEquals_AnyN_AnyN_StrN_k_(listOf_Arr_k_(["three", "one", "two"]), keys)
            values = toList_rIterable_k_(map.get_values())
            assertEquals_AnyN_AnyN_StrN_k_(listOf_Arr_k_([3, 1, 2]), values)
        end function})
        m.test_Str_Function0V_k_("insertion order with updates", {invoke: function() as Void
            map = LinkedHashMap_create_k_()
            set_rMutableMap_AnyN_AnyN_k_(map, "one", 1)
            set_rMutableMap_AnyN_AnyN_k_(map, "two", 2)
            set_rMutableMap_AnyN_AnyN_k_(map, "three", 3)
            set_rMutableMap_AnyN_AnyN_k_(map, "two", 22)
            keys = toList_rIterable_k_(map.get_keys())
            assertEquals_AnyN_AnyN_StrN_k_(listOf_Arr_k_(["one", "two", "three"]), keys)
            assertEquals_AnyN_AnyN_StrN_k_(22, map.get_AnyN_k_("two"))
        end function})
        m.test_Str_Function0V_k_("constructor with map", {invoke: function() as Void
            original = mapOf_Arr_k_([to_rAnyN_AnyN_k_("a", 1), to_rAnyN_AnyN_k_("b", 2), to_rAnyN_AnyN_k_("c", 3)])
            linked = LinkedHashMap_create_Map_k_(original)
            assertEquals_AnyN_AnyN_StrN_k_(3, linked.get_size())
            assertTrue_Z_StrN_k_(linked.containsKey_AnyN_k_("a"))
            assertTrue_Z_StrN_k_(linked.containsKey_AnyN_k_("b"))
            assertTrue_Z_StrN_k_(linked.containsKey_AnyN_k_("c"))
        end function})
        m.test_Str_Function0V_k_("put and get", {invoke: function() as Void
            map = LinkedHashMap_create_k_()
            assertNull_AnyN_StrN_k_(map.put_AnyN_AnyN_k_(1, "one"))
            assertEquals_AnyN_AnyN_StrN_k_("one", map.put_AnyN_AnyN_k_(1, "ONE"))
            assertEquals_AnyN_AnyN_StrN_k_("ONE", map.get_AnyN_k_(1))
        end function})
        m.test_Str_Function0V_k_("remove", {invoke: function() as Void
            map = LinkedHashMap_create_k_()
            set_rMutableMap_AnyN_AnyN_k_(map, "one", 1)
            set_rMutableMap_AnyN_AnyN_k_(map, "two", 2)
            set_rMutableMap_AnyN_AnyN_k_(map, "three", 3)
            assertEquals_AnyN_AnyN_StrN_k_(2, map.remove_AnyN_k_("two"))
            assertFalse_Z_StrN_k_(map.containsKey_AnyN_k_("two"))
            assertEquals_AnyN_AnyN_StrN_k_(2, map.get_size())
            keys = toList_rIterable_k_(map.get_keys())
            assertEquals_AnyN_AnyN_StrN_k_(listOf_Arr_k_(["one", "three"]), keys)
        end function})
        m.test_Str_Function0V_k_("clear", {invoke: function() as Void
            map = LinkedHashMap_create_k_()
            set_rMutableMap_AnyN_AnyN_k_(map, "one", 1)
            set_rMutableMap_AnyN_AnyN_k_(map, "two", 2)
            map.clear_k_()
            assertEquals_AnyN_AnyN_StrN_k_(0, map.get_size())
            assertTrue_Z_StrN_k_(map.isEmpty_k_())
        end function})
        m.test_Str_Function0V_k_("iterator remove", {invoke: function() as Void
            map = LinkedHashMap_create_k_()
            set_rMutableMap_AnyN_AnyN_k_(map, "one", 1)
            set_rMutableMap_AnyN_AnyN_k_(map, "two", 2)
            set_rMutableMap_AnyN_AnyN_k_(map, "three", 3)
            iter = map.get_keys().iterator_k_()
            while iter.hasNext_k_()
                if iter.next_k_() = "two" then
                    iter.remove_k_()
                end if
            end while
            assertEquals_AnyN_AnyN_StrN_k_(2, map.get_size())
            assertFalse_Z_StrN_k_(map.containsKey_AnyN_k_("two"))
        end function})
        m.test_Str_Function0V_k_("entry set", {invoke: function() as Void
            map = LinkedHashMap_create_k_()
            set_rMutableMap_AnyN_AnyN_k_(map, "one", 1)
            set_rMutableMap_AnyN_AnyN_k_(map, "two", 2)
            entries = toList_rIterable_k_(map.get_entries())
            assertEquals_AnyN_AnyN_StrN_k_(2, entries.get_size())
            assertEquals_AnyN_AnyN_StrN_k_("one", entries.get_I_k_(0).get_key())
            assertEquals_AnyN_AnyN_StrN_k_(1, entries.get_I_k_(0).get_value())
        end function})
        m.test_Str_Function0V_k_("putAll", {invoke: function() as Void
            map = LinkedHashMap_create_k_()
            set_rMutableMap_AnyN_AnyN_k_(map, "one", 1)
            other = mapOf_Arr_k_([to_rAnyN_AnyN_k_("two", 2), to_rAnyN_AnyN_k_("three", 3)])
            map.putAll_Map_k_(other)
            assertEquals_AnyN_AnyN_StrN_k_(3, map.get_size())
            assertEquals_AnyN_AnyN_StrN_k_(listOf_Arr_k_(["one", "two", "three"]), toList_rIterable_k_(map.get_keys()))
        end function})
    end function})
end sub
