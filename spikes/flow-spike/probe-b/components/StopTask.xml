<?xml version="1.0" encoding="utf-8" ?>
<component name="StopTask" extends="Task">
    <!-- Progress fields written by the task thread, sampled by the scene
         post-STOP (the node object stays readable after its thread dies —
         B7 verifies this explicitly). No field named "state"/"control":
         those are Task built-ins. -->
    <interface>
        <field id="mode" type="string" value="" />
        <field id="beatCount" type="integer" value="0" />
        <field id="phase" type="string" value="" />
        <field id="cleanupRan" type="boolean" value="false" />
        <field id="cancelRequested" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/StopTask.brs" />
</component>
